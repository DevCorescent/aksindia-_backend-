PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_JWT_EXPIRES_IN=30d

# Single origin (simple setup)
FRONTEND_URL=http://localhost:5173

# Multiple origins comma-separated (production)
# FRONTEND_URLS=https://askindia.in,https://www.askindia.in,http://localhost:5173

# Mail delivery (SMTP via nodemailer) — required for password-reset links to
# reach users. Works with any provider: Resend, SendGrid, SES, Postmark, Gmail…
# Leave unset and the backend logs the failure instead of silently pretending the
# mail was sent; outside production the reset link is returned in the response.
# MAIL_FROM=no-reply@askindia.in
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_api_key_here
# SMTP_SECURE=false          # true only for port 465 (implicit TLS)

# Password recovery method (read at start-up — restart/redeploy after changing).
#   false (default): "Forgot password?" emails a one-time reset link.
#   true:            "Forgot password?" emails a 6-digit code (10 min, 5 attempts,
#                    single use) and enables "Forgot User ID". Needs SMTP above.
# Only "true" enables it; anything else is treated as false.
PASSWORD_RESET_OTP_ENABLED=false

# Razorpay (payment gateway)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary (image uploads) — optional, add if using backend upload proxy
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
